# Copia este archivo como .env y completa los valores. Nunca subas secretos reales.

# Conexión a PostgreSQL (en Railway se toma de la base de datos del proyecto).
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/sitio_jjmm

# Secreto con el que Payload firma sesiones y tokens. Usa una cadena aleatoria larga,
# por ejemplo la salida de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# URL pública del sitio: solo el origen, sin ruta ni barra final. Se usa en canonical, Open Graph,
# sitemap, robots y datos estructurados. Es obligatoria en producción: sin ella (o mal escrita)
# `pnpm build` y `pnpm start` fallan al cargar next.config.ts. Next la incrusta al compilar.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Almacenamiento de medios en Wasabi (compatible con S3).
# Si falta cualquiera de estas variables, el adaptador queda desactivado y los archivos
# se guardan en la carpeta local media/ (solo para desarrollo).
WASABI_BUCKET=
WASABI_REGION=us-east-1
# Endpoint de la región, por ejemplo https://s3.us-east-1.wasabisys.com
WASABI_ENDPOINT=
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=

# Primer administrador que crea `pnpm semilla` (carga inicial). Define las dos o ninguna:
# sin ellas la carga no crea usuarios. Si la cuenta ya existe, no se modifica.
SEMILLA_ADMIN_CORREO=
SEMILLA_ADMIN_CLAVE=

# Encabezado confiable con la IP del visitante para limitar los envíos del formulario de contacto.
# Usa x-real-ip detrás de Railway y cf-connecting-ip cuando Cloudflare esté delante.
ENCABEZADO_IP_CLIENTE=x-real-ip
